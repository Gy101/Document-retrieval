# Copy to .env and adjust before local deployment.
# Spring Boot does not load .env automatically; export these variables in your
# shell, or pass them explicitly when starting the jar/container.
# Never commit a real .env file.

# Spring profile: prod | dev
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=doc_format_check
MYSQL_USER=doccheck
MYSQL_PASSWORD=change-me

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Demo administrator (change before exposing the service)
DEMO_USERNAME=admin
DEMO_PASSWORD=change-me

# DSH model gateway. Keep DSH_MOCK=true for a keyless local demo.
DSH_MOCK=true
DSH_BASE_URL=https://api.dsh.example.com
DSH_API_KEY=
DSH_MODEL=dsh-chat
DSH_CHAT_PATH=/v1/chat/completions

# Local file storage
STORAGE_TYPE=local
STORAGE_ROOT=./data/uploads

# Multi-instance queue. Set a unique value per instance in production.
CHECK_INSTANCE_ID=

# Reverse proxy: enable only when a trusted proxy overwrites client IP headers.
AUTH_TRUST_PROXY=false

# Custom YAML search rules
SEARCH_RULES_FILE=./config/search-rules.yml
